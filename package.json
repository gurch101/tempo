{
  "name": "tempo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "dev": "npm run build:client && wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:json": "node scripts/import-json.mjs",
    "migrate:local": "wrangler d1 migrations apply tempo-preview --local",
    "migrate:preview": "wrangler d1 migrations apply tempo-preview --remote",
    "migrate:production": "wrangler d1 migrations apply tempo-production --remote --env production",
    "deploy:preview": "npm run build:client && wrangler deploy",
    "deploy:production": "npm run build:client && wrangler deploy --env production",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "d1-admin": "file:../d1-admin",
    "hono": "^4.9.2",
    "qrcode-generator": "^1.4.4",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.120.0"
  }
}
